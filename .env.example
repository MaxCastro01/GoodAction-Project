PORT=3000

# Obligatoria: clave para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=cambia-esta-clave-por-un-valor-largo-y-aleatorio

# Administrador inicial (se crea al arrancar si no existe). El registro publico
# solo crea cuentas con rol "usuario".
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@goodaction.local
ADMIN_PASSWORD=cambia-esta-contrasena

# Limites de intentos por IP cada 15 minutos (opcionales)
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20
